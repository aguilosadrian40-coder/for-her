<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Jai ❤️</title>

<style>
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #ff758c, #ff7eb3);
        font-family: 'Segoe UI', sans-serif;
        color: white;
        text-align: center;
        overflow: hidden;
    }

    .container {
        width: 90%;
        max-width: 400px;
        background: rgba(255,255,255,0.15);
        padding: 25px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 20px rgba(0,0,0,0.2);
    }

    h1 {
        font-size: 28px;
        margin-bottom: 15px;
    }

    #typing {
        font-size: 18px;
        min-height: 50px;
        border-right: 2px solid white;
        display: inline-block;
        padding-right: 5px;
        white-space: normal;
    }

    button {
        margin-top: 20px;
        padding: 10px 20px;
        font-size: 16px;
        border: none;
        border-radius: 20px;
        background: white;
        color: #ff4d6d;
        cursor: pointer;
        width: 100%;
    }

    #secret {
        margin-top: 15px;
        font-size: 16px;
        display: none;
        animation: fadeIn 2s ease;
    }

    @keyframes fadeIn {
        from {opacity: 0;}
        to {opacity: 1;}
    }

    .hearts {
        position: fixed;
        width: 100%;
        height: 100%;
        pointer-events: none;
        overflow: hidden;
    }

    .heart {
        position: absolute;
        color: rgba(255,255,255,0.7);
        animation: float 6s linear infinite;
    }

    @keyframes float {
        0% {transform: translateY(100vh);}
        100% {transform: translateY(-10vh);}
    }
</style>
</head>

<body>

<div class="container">
    <h1>For Jai ❤️</h1>
    <div id="typing"></div>

    <button onclick="startExperience()">Tap Me 💌</button>

    <div id="secret">
        Hello, yes nagkakaroon na ako ng
        feelings sayo kasi ikaw lang nakakausap ko and
        nagpapangiti sakin minsan kaya ayun
    </div>
</div>

<div class="hearts" id="hearts"></div>

<!-- Music -->
<audio id="music" loop>
    <!-- Replace this with your own uploaded file link of "Aya" -->
    <source src="https://drive.google.com/uc?export=download&id=1GVCDht6uakRHGHrLxsALTA5pWSF3FuX5" type="audio/mp3">
</audio>

<script>
    // Typing effect text
    const text = "Tinetesting lang kung ano magiging reaction mo pero sana magustuhan mo";
    let i = 0;

    function typingEffect() {
        if (i < text.length) {
            document.getElementById("typing").innerHTML += text.charAt(i);
            i++;
            setTimeout(typingEffect, 50);
        }
    }

    function startExperience() {
        // Start typing
        typingEffect();

        // Show message
        document.getElementById("secret").style.display = "block";

        // Play music (mobile requires user interaction)
        const music = document.getElementById("music");
        music.play().catch(() => {});

        // Disable button after click
        event.target.disabled = true;
        event.target.innerText = "I Love You ❤️";
    }

    // Floating hearts
    function createHeart() {
        const heart = document.createElement("div");
        heart.classList.add("heart");
        heart.innerHTML = "❤️";
        heart.style.left = Math.random() * 100 + "vw";
        heart.style.fontSize = (Math.random() * 15 + 10) + "px";
        heart.style.animationDuration = (Math.random() * 3 + 3) + "s";
        document.getElementById("hearts").appendChild(heart);

        setTimeout(() => {
            heart.remove();
        }, 6000);
    }

    setInterval(createHeart, 400);
</script>

</body>
</html>
